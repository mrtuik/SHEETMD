{
  "expo": {
    "name": "Sheet.md",
    "slug": "sheet-md",
    "version": "1.0.0",
    "orientation": "portrait",
    "newArchEnabled": false,
    "android": {
      "package": "com.metuik.sheetmd",
      "permissions": [
        "RECORD_AUDIO",
        "WAKE_LOCK"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "expo-sqlite",
      [
        "@react-native-voice/voice",
        {
          "microphonePermission": "Sheet.md needs the mic for voice commands."
        }
      ],
      "./plugins/withSpeechQueries"
    ],
    "icon": "./assets/icon.png"
  }
}